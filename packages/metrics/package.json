{
    "name": "@proton/metrics",
    "description": "Metrics library",
    "sideEffects": false,
    "exports": {
        "./eventLoopMetrics": "./eventLoopMetrics.ts",
        "./metricsInstance": "./metricsInstance.ts",
        "./observeApiError": "./lib/observeApiError.ts",
        "./types/desktop_inbox_heartbeat_total_v1.schema": "./types/desktop_inbox_heartbeat_total_v1.schema.d.ts",
        "./types/docs_readonly_mode_documents_total_v1.schema": "./types/docs_readonly_mode_documents_total_v1.schema.d.ts",
        "./types/docs_realtime_disconnect_error_total_v2.schema": "./types/docs_realtime_disconnect_error_total_v2.schema.d.ts",
        "./types/drive_download_errors_total_v2.schema": "./types/drive_download_errors_total_v2.schema.d.ts",
        "./types/drive_photos_transfer_to_photo_stream_histogram_v1.schema": "./types/drive_photos_transfer_to_photo_stream_histogram_v1.schema.d.ts",
        "./types/drive_sync_errors_total_v1.schema": "./types/drive_sync_errors_total_v1.schema.d.ts",
        "./types/drive_thumbnail_errors_total_v1.schema": "./types/drive_thumbnail_errors_total_v1.schema.d.ts",
        "./types/drive_users_success_rate_total_v1.schema": "./types/drive_users_success_rate_total_v1.schema.d.ts",
        "./types/web_core_vpn_single_signup_step1_interaction_total_v1.schema": "./types/web_core_vpn_single_signup_step1_interaction_total_v1.schema.d.ts",
        "./types/web_drive_search_environment_incompatibility_total_v1.schema": "./types/web_drive_search_environment_incompatibility_total_v1.schema.d.ts",
        "./types/web_drive_search_permanent_errors_total_v1.schema": "./types/web_drive_search_permanent_errors_total_v1.schema.d.ts",
        "./types/web_mail_performance_email_list_display_time_histogram_v1.schema": "./types/web_mail_performance_email_list_display_time_histogram_v1.schema.d.ts",
        "./webvitals": "./webvitals.ts"
    },
    "scripts": {
        "check:types": "tsc --checkers 1",
        "generate-metrics": "ts-node -P scripts/tsconfig.metrics-scripts.json ./scripts/generate-metrics.ts",
        "generate-schema-types": "bash scripts/generate-schema-types.sh",
        "lint": "oxlint --quiet",
        "test": "vitest",
        "test:ci": "pnpm run test --run",
        "test:watch": "pnpm run test --watch",
        "update-metrics": "rimraf json-schema-registry types && git clone $SCHEMA_REPOSITORY && pnpm run generate-schema-types && pnpm run generate-metrics"
    },
    "dependencies": {
        "@proton/oxfmt-config": "workspace:^",
        "@proton/shared": "workspace:^",
        "typescript": "catalog:",
        "web-vitals": "^4.2.4"
    },
    "devDependencies": {
        "@proton/oxlint-config": "workspace:^",
        "@proton/vitest-config": "workspace:^",
        "@types/node": "catalog:",
        "@types/webpack-env": "catalog:",
        "@typescript/native": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "happy-dom": "catalog:",
        "json-schema-to-typescript": "^13.1.2",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "rimraf": "^5.0.10",
        "ts-node": "catalog:",
        "vitest": "catalog:",
        "vitest-fetch-mock": "^0.4.5"
    }
}
