        "date-fns": "^2.30.0",
        "dompurify": "^3.4.13",
        "electron-log": "^5.4.4",
        "file-saver": "^2.0.5",
        "ical.js": "^1.5.0",
        "idb": "^8.0.3",
        "is-valid-domain": "0.1.6",
        "linkify-it": "^5.0.2",
        "lodash": "^4.18.1",
        "minimist": "^1.2.8",
        "papaparse": "^5.6.0",
        "react": "^18.3.1",
        "tinycolor2": "^1.6.0",
        "ttag": "^1.8.12",
        "ua-parser-js": "^1.0.41",
        "web-streams-polyfill": "^3.3.3",
        "web-vitals": "^4.2.4",
