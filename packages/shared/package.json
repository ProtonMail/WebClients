        "@vitest/browser-playwright": "^4.1.10",
        "@webgpu/types": "^0.1.71",
        "eslint": "^10.8.1",
        "playwright": "^1.61.1",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "@proton/app-context": "workspace:^",
