{
    "name": "@proton/colors",
    "version": "0.0.2",
    "description": "Package containing the logic for Proton's design system color computations",
    "scripts": {
        "build": "webpack-cli",
        "check-types": "tsc --checkers 1",
        "generate": "ts-node -P tsconfig.generate.json gen-themes-cli",
        "lint": "eslint --quiet",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --ci --logHeapUsage",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@proton/utils": "workspace:^",
        "@types/node": "^24.13.6",
        "css-tree": "^2.3.1",
        "prettier": "^3.9.8",
        "tinycolor2": "^1.6.0"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.2",
        "@proton/eslint-config-proton": "workspace:^",
        "@proton/jest-swc-preset": "workspace:^",
        "@proton/types": "workspace:^",
        "@types/css-tree": "^2.3.11",
        "@types/jest": "^30.0.0",
        "@types/tinycolor2": "^1.4.6",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.11.0",
        "jest": "^30.5.2",
        "ts-node": "^10.9.2",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3"
    }
}
