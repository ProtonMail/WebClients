{
    "name": "@proton/raw-images",
    "version": "1.0.0",
    "description": "Processing RAW Images with WASM",
    "repository": "git@gitlab.protontech.ch:drive/raw-images.git",
    "author": "Gregory Linford <gregory.linford@proton.ch>",
    "exports": {
        "./createWorker": "./src/createWorker.ts"
    },
    "files": [
        "src",
        "build-dcraw.sh",
        "build-cr3.sh",
        "dist/dcraw.js",
        "dist/dcraw.wasm",
        "dist/cr3.js",
        "dist/cr3.wasm"
    ],
    "scripts": {
        "build": "bash ./build-dcraw.sh && bash ./build-cr3.sh",
        "format:check": "oxfmt --check \"**/*.{js,ts,tsx}\"",
        "format:write": "oxfmt --write \"**/*.{js,ts,tsx}\"",
        "lint": "oxlint --quiet"
    },
    "devDependencies": {
        "@proton/oxlint-config": "workspace:^",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:"
    }
}
