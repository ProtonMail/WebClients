        "@types/jest": "catalog:",
        "@types/node": "catalog:",
        "@types/webpack-env": "catalog:",
        "@typescript/native": "npm:typescript@^7.0.2",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2004",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
