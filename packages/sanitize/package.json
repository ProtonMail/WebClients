{
    "name": "@proton/sanitize",
    "private": true,
    "description": "HTML/CSS sanitization utilities",
    "sideEffects": false,
    "exports": {
        "./escape": "./src/escape.ts",
        "./purify": "./src/purify.ts"
    },
    "scripts": {
        "check:types": "tsc --checkers 1",
        "lint": "oxlint --quiet",
