        "@proton/oxlint-config": "workspace:^",
        "@proton/utils": "workspace:^",
        "@testing-library/react-hooks": "catalog:",
        "@types/jest": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/webpack-env": "catalog:",
        "@typescript/native": "catalog:",
        "jest": "catalog:",
        "jest-environment-jsdom": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "react-test-renderer": "^18.3.1",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
