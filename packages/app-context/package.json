{
    "name": "@proton/app-context",
    "description": "React contexts for the application runtime services (api, config, cache, notifications)",
    "license": "GPL-3.0",
    "sideEffects": false,
    "type": "module",
    "exports": {
        "./apiContext": "./apiContext.ts",
        "./cacheContext": "./cacheContext.ts",
        "./configContext": "./configContext.ts",
        "./notifications/constants": "./notifications/constants.ts",
        "./notifications/interfaces": "./notifications/interfaces.ts",
        "./notifications/manager": "./notifications/manager.tsx",
        "./notifications/notificationsContext": "./notifications/notificationsContext.ts",
        "./useApi": "./useApi.ts",
        "./useCache": "./useCache.ts",
        "./useConfig": "./useConfig.ts",
        "./useNotifications": "./useNotifications.ts",
        "./testing/mockTelemetry": "./testing/mockTelemetry.ts",
        "./testing/mockUseApi": "./testing/mockUseApi.ts",
        "./testing/mockUseConfig": "./testing/mockUseConfig.ts",
        "./testing/mockUseNotifications": "./testing/mockUseNotifications.ts",
        "./testing/vitest/mockUseApi": "./testing/vitest/mockUseApi.ts",
        "./testing/vitest/mockUseConfig": "./testing/vitest/mockUseConfig.ts",
        "./testing/vitest/mockUseNotifications": "./testing/vitest/mockUseNotifications.ts",
        "./useSilentApi": "./useSilentApi.ts"
    },
    "scripts": {
        "check:types": "tsc --checkers 1",
        "lint": "oxlint --quiet",
