{
    "name": "@proton/pass",
    "description": "Proton Pass shared codebase",
    "license": "GPL-3.0",
    "sideEffects": false,
    "scripts": {
        "check-types": "tsc",
        "cherry": "scripts/cherry.sh",
        "docs:build": "yarn workspace @proton/pass-docs build",
        "docs:dev": "yarn workspace @proton/pass-docs dev",
        "generate:api-types": "API=${API:-proton.black} ./utils/openapi/index.ts \"https://${API}/api/internal/doc?page=pass\" > ./types/api/pass.ts",
        "generate:proto": "scripts/generate-protos.sh",
        "generate:rule-types": "./lib/extension/rules/generate.sh",
        "generator:openapi": "./utils/openapi/index.ts",
        "i18n:validate": "proton-i18n validate lint-functions",
        "lint": "eslint --quiet",
        "pretty": "prettier --write  $(find src/app -type f -name '*.js' -o -name '*.ts' -o -name '*.tsx')",
        "start": "proton-pack dev-server --appMode=standalone",
        "sync:fathom": "scripts/sync-fathom.sh",
        "test": "NODE_NO_WARNINGS=1 jest --verbose --coverage",
        "test:ci": "yarn test:tz && jest --coverage --runInBand --ci --logHeapUsage",
        "test:tz": "bash -c 'for tz in UTC America/New_York Europe/Paris Asia/Tokyo; do TZ=$tz yarn test time/format.spec.ts || exit 1; done'",
        "test:watch": "jest --watch",
        "version:update": "scripts/version.sh"
    },
    "dependencies": {
        "@proton/account": "workspace:^",
        "@proton/app-context": "workspace:^",
        "@proton/atoms": "workspace:^",
        "@proton/colors": "workspace:^",
        "@proton/components": "workspace:^",
        "@proton/cross-storage": "workspace:^",
        "@proton/hooks": "workspace:^",
        "@proton/icons": "workspace:^",
        "@proton/key-transparency": "workspace:^",
        "@proton/payments": "workspace:^",
        "@proton/polyfill": "workspace:^",
        "@proton/shared": "workspace:^",
        "@proton/styles": "workspace:^",
        "@proton/types": "workspace:^",
        "@proton/utils": "workspace:^",
        "@protontech/autofill": "0.0.38040317",
        "@protontech/crypto": "*",
        "@protontech/pass-rust-core": "1.6.0",
        "@reduxjs/toolkit": "^2.12.0",
        "@zip.js/zip.js": "^2.8.57",
        "client-zip": "^2.5.0",
        "date-fns": "^2.30.0",
        "formik": "^2.4.9",
        "history": "^4.10.1",
        "idb": "^8.0.3",
        "imask": "^7.6.1",
        "lodash": "^4.18.1",
        "loglevel": "^1.9.2",
        "otpauth": "^9.5.1",
        "papaparse": "^5.6.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-redux": "^9.3.0",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4",
        "react-virtualized": "^9.22.6",
        "redux": "^5.0.1",
        "redux-saga": "^1.5.0",
        "safe-regex2": "^5.1.1",
        "tldts": "^7.4.10",
        "ttag": "^1.8.12",
        "webextension-polyfill": "^0.12.0",
        "x2js": "^3.4.4"
    },
    "devDependencies": {
        "@protobuf-ts/plugin": "^2.11.1",
        "@proton/eslint-config-proton": "workspace:^",
        "@proton/i18n": "workspace:^",
        "@proton/jest-env": "workspace:^",
        "@proton/prettier-config-proton": "workspace:^",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^15.0.7",
        "@testing-library/react-hooks": "^8.0.1",
        "@types/chrome": "^0.2.7",
        "@types/lodash": "^4.17.25",
        "@types/mime-types": "^2.1.4",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@types/react-router-dom": "^5.3.3",
        "@types/webextension-polyfill": "^0.12.5",
        "@typescript/native": "npm:typescript@^7.0.2",
        "circular-dependency-plugin": "^5.2.2",
        "core-js": "^3.50.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.9.0",
        "fake-indexeddb": "^6.2.5",
        "jest": "^30.4.2",
        "jsdom": "^29.1.1",
        "json-schema-to-typescript": "^13.1.2",
        "jszip": "^3.10.1",
        "openapi-types": "^12.1.3",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "webpack": "^5.109.2"
    }
}
