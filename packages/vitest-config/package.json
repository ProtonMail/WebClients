{
    "name": "@proton/vitest-config",
    "description": "Shared vitest configuration for workspace packages",
    "type": "module",
    "exports": {
        "./react": "./src/react.ts",
        "./setLocation": "./src/setLocation.ts",
        "./setup": "./src/setup.ts",
        "./shared": "./src/shared.ts"
    },
    "scripts": {
        "check:types": "tsc --checkers 1",
        "format:check": "oxfmt --check \"**/*.{js,ts,tsx}\"",
        "format:write": "oxfmt --write \"**/*.{js,ts,tsx}\"",
        "lint": "oxlint --quiet",
        "lint:fix": "pnpm run lint --fix"
    },
    "dependencies": {
        "@testing-library/dom": "catalog:",
        "@testing-library/jest-dom": "catalog:"
    },
    "devDependencies": {
        "@proton/oxlint-config": "workspace:^",
        "@types/node": "catalog:",
        "@types/webpack-env": "catalog:",
        "@typescript/native": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "vitest": "^5.1.1"
    }
}
