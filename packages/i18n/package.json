{
    "name": "@proton/i18n",
    "description": "CLI to extract/validate translations from the code",
    "keywords": [],
    "license": "ISC",
    "author": "Proton AG",
    "main": "index.js",
    "bin": {
        "proton-i18n": "index.js"
    },
    "scripts": {
        "format:check": "oxfmt --check \"lib/**/*.js\" index.js",
        "format:write": "oxfmt --write \"lib/**/*.js\" index.js",
        "lint": "oxlint --quiet",
        "test": "./test/test-linter.sh* && ./test/test-validator.sh",
        "test:ci": "pnpm run test"
    },
    "dependencies": {
        "execa": "catalog:",
        "gettext-parser": "^7.0.1",
        "glob": "catalog:",
        "ttag-cli": "catalog:"
    },
    "devDependencies": {
        "@proton/oxlint-config": "workspace:^",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:"
    }
}
