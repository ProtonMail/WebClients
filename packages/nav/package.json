{
    "name": "@proton/nav",
    "description": "Shared navigation definition builder",
    "type": "module",
    "exports": {
        "./*": "./src/*.ts"
    },
    "scripts": {
        "check-types": "tsc --checkers 1",
        "lint": "eslint --quiet",
