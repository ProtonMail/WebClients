{
    "name": "@proton/nav",
    "description": "Shared navigation definition builder",
    "type": "module",
    "exports": {
        "./*": "./src/*.ts"
    },
    "main": "./src/index.ts",
    "scripts": {
        "check-types": "tsc",
        "lint": "eslint --quiet",
        "test": "TZ=UTC vitest",
        "test:ci": "yarn test --coverage --run",
        "test:ui": "yarn test --ui",
        "test:watch": "yarn test --watch"
    },
    "dependencies": {
        "@proton/components": "workspace:^",
        "@proton/icons": "workspace:^",
        "@proton/shared": "workspace:^"
    },
    "devDependencies": {
        "@proton/eslint-config-proton": "workspace:^",
        "@proton/testing": "workspace:^",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "eslint": "^10.8.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10"
    }
}
