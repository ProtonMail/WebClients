{
    "name": "@proton/charts",
    "description": "Shared chart components: owns chart.js, its registration and theme colour resolution",
    "license": "GPL-3.0",
    "author": "",
    "sideEffects": [
        "./src/register.ts",
        "./src/primitives/*.tsx"
    ],
    "type": "module",
    "exports": {
        "./ChartCard": "./src/presentation/ChartCard.tsx",
        "./TrendChart": "./src/charts/TrendChart/TrendChart.tsx",
        "./TrendChart.types": "./src/charts/TrendChart/TrendChart.types.ts"
    },
    "scripts": {
