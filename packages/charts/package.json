        "react": "^18.3.1",
        "react-chartjs-2": "^5.3.1"
    },
    "devDependencies": {
        "@proton/eslint-config-proton": "workspace:^",
        "@proton/vitest-config": "workspace:^",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^15.0.7",
        "@types/react": "^18.3.31",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/ui": "^4.1.11",
        "eslint": "^9.39.5",
        "happy-dom": "^20.14.5",
        "react-dom": "^18.3.1",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
