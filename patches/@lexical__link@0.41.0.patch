@@ -437,6 +437,11 @@ function $splitLinkAtSelection(parentLink, extractedNodes) {
     parentLink.remove();
     return;
   }
+  // Patched: a link in the selection with none of its children in it, such as one the selection only
+  // touches at an edge, stays as it is, as before 0.40.0. Unpatched, unlinking throws.
+  if (extractedChildren.length === 0) {
+    return;
+  }
   const firstExtractedIndex = allChildren.findIndex(isExtractedChild);
   const lastExtractedIndex = allChildren.findLastIndex(isExtractedChild);
   const isAtStart = firstExtractedIndex === 0;
