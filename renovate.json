{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended", "group:allNonMajor", ":semanticCommitsDisabled"],
    "postUpdateOptions": ["pnpmDedupe"],
    "rangeStrategy": "bump",
    "rebaseWhen": "conflicted",
    "prConcurrentLimit": 2,
    "minimumReleaseAge": "3 days",
    "ignoreDeps": [
        "@protontech/drive-sdk",
        "@proton/proton-foundation-search",
        "@proton-meet/proton-meet-core",
        "roosterjs",
        "emoji-mart",
        "@emoji-mart/data",
        "@protontech/crypto",
        "@protontech/pass-rust-core",
        "@mlc-ai/web-llm",
        "pdfjs-dist",
        "sass",
        "node"
    ],
    "ignorePaths": [
        "**/node_modules/**",
        "vendor/**",
        "applications/authenticator/src-tauri/**",
        "applications/pass-extension/safari/**",
        "applications/pass-desktop/native/**",
        "applications/pass-desktop/macOS/**"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "ci-base versions published by schedule:ci-base",
            "managerFilePatterns": ["/^ci/images/ci-base-version\\.yml$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+CI_BASE_VERSION: (?<currentValue>\\S+)"
            ]
        }
    ],
    "packageRules": [
        {
            "description": "Our own image, in its own MR, opened even when other Renovate MRs have used up prConcurrentLimit. Harbor gives its tags no release timestamp, so minimumReleaseAge would hold every version back.",
            "groupName": "ci-base",
            "matchPackageNames": ["harbor.protontech.ch/web-clients/ci-base"],
            "minimumReleaseAge": null,
            "prConcurrentLimit": 0
        },
        {
            "groupName": "Playwright",
            "matchPackageNames": ["/playwright/", "!@vitest/**"]
        },
        {
            "groupName": "msw",
            "matchPackageNames": ["/msw/"]
        },
        {
            "groupName": "Typescript",
            "matchPackageNames": ["typescript"]
        },
        {
            "groupName": "lexical",
            "matchPackageNames": ["@lexical/*", "lexical", "yjs", "y-protocols"]
        },
        {
            "groupName": "Unleash",
            "matchPackageNames": ["@unleash/proxy-client-react", "unleash-proxy-client"]
        },
        {
            "groupName": "pdfme",
            "matchPackageNames": ["@pdfme/*"]
        },
        {
            "groupName": "redux",
            "matchPackageNames": ["/redux/"]
        },
        {
            "groupName": "babel",
            "matchPackageNames": ["/babel/"]
        },
        {
            "description": "exifreader >=4.52 ships ESM-only sources; drive Jest needs a transformIgnorePatterns update before it can land",
            "groupName": "exifreader",
            "matchPackageNames": ["exifreader"]
        },
        {
            "description": "@tanstack/react-virtual 3.14.24 breaks DriveExplorer keyboard navigation tests (rows not rendered)",
            "groupName": "tanstack virtual",
            "matchPackageNames": ["@tanstack/react-virtual"]
        },
        {
            "description": "Autofill/fathom bumps change form detection and need Pass team validation",
            "groupName": "Pass autofill",
            "matchPackageNames": ["@protontech/autofill", "@protontech/fathom"]
        },
        {
            "description": "axios 1.21 bump coincided with ci-tools Slack connectivity integration test timing out",
            "groupName": "axios",
            "matchPackageNames": ["axios"]
        },
        {
            "description": "mdast-util-to-markdown 2.2 changes emphasis serialization (***x*** -> **_x_**), breaking the lumo markdownEditorDoc test",
            "groupName": "mdast-util-to-markdown",
            "matchPackageNames": ["mdast-util-to-markdown"]
        },
        {
            "description": "Express 4 needs the 0.1.x line. 0.2.x is an unpatched 2014 release that only looks newer (GHSA-9wv6-86v2-598j)",
            "matchPackageNames": ["path-to-regexp"],
            "matchCurrentVersion": "<0.2.0",
            "allowedVersions": "<0.2.0"
        },
        {
            "groupName": "pass-desktop and inbox-desktop exclusions",
            "enabled": false,
            "matchPackageNames": ["@electron-forge/*", "@electron/fuses", "@vercel/webpack-asset-relocator-loader"]
        },
        {
            "groupName": "quark packages",
            "enabled": false,
            "matchPackageNames": ["@tpe/quark-client", "@tpe/quark-types", "@tpe/user-builder"]
        },
        {
            "groupName": "ignore inbox-desktop snapcraft image",
            "matchPackageNames": ["harbor.protontech.ch/ghcr.io/canonical/snapcraft"],
            "enabled": false
        },
        {
            "groupName": "ignore ariakit",
            "matchPackageNames": ["@ariakit/*"],
            "enabled": false
        },
        {
            "groupName": "ignore standardnotes",
            "matchPackageNames": ["@standardnotes/*"],
            "enabled": false
        }
    ]
}
