{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@proton/types", "global-types-monorepo", "webpack-env", "vitest/globals"],
    "paths": {
      // Support import aliases.
      "~/components/*": ["./src/app/components/*"],
      "~/drive-sdk/*": ["./src/app/drive-sdk/*"],
      "~/utils/*": ["./src/app/utils/*"],
      "~/redux-store/*": ["./src/app/redux-store/*"],
      "~/homepage": ["./src/app/homepage"],
      "~/config": ["./src/app/config"]
    }
  },
  // vitest.config.ts is left out: it pulls in vitest's browser-mode matcher types, which clash with jest-dom's (toHaveTextContent(RegExp))
  "exclude": ["vitest.config.ts", "**/node_modules", "**/.*/", "dist", "**/*.spec.ts"]
}
