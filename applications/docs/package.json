{
  "name": "proton-docs",
  "description": "Proton Docs.",
  "license": "GPL-3.0",
  "author": "",
  "exports": {
    "./homepage": "./src/app/homepage/index.ts",
    "./tailwind.config": "./tailwind.config.js"
  },
  "scripts": {
    "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=sso --handleSupportAndErrors --optimizeAssets --babelLoader --noLogicalScss ",
    "check:types": "tsc --checkers 1",
    "i18n:extract:web": "proton-i18n extract",
    "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin --verbose",
    "i18n:validate": "proton-i18n validate lint-functions",
    "i18n:validate:context:web": "proton-i18n validate",
    "lint": "oxlint --quiet",
    "lint:warning": "oxlint",
    "pretty": "oxfmt --write \"src/app/**/*.{js,ts,tsx}\"",
    "start": "cross-env TS_NODE_TRANSPILE_ONLY=true TS_NODE_IGNORE_DIAGNOSTICS=5011 TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --optimizeAssets --babelLoader --noLogicalScss",
    "start:lite": "vite optimize --config vite.dev.config.mts --logLevel warn && vite --config vite.dev.config.mts",
    "test": "vitest --run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ariakit/react": "0.4.29",
    "@lexical/utils": "catalog:docs",
    "@proton-docs/realtime-sdk": "0.15.0",
