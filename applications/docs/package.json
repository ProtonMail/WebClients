{
  "name": "proton-docs",
  "description": "Proton Docs.",
  "license": "GPL-3.0",
  "author": "",
  "scripts": {
    "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=sso --handleSupportAndErrors --optimizeAssets --babelLoader --noLogicalScss ",
    "check-types": "tsc",
    "i18n:extract:web": "proton-i18n extract",
    "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin --verbose",
    "i18n:validate": "proton-i18n validate lint-functions",
    "i18n:validate:context:web": "proton-i18n validate",
    "lint": "eslint --quiet",
    "lint:warning": "eslint",
    "pretty": "prettier --write  $(find src/app -type f -name '*.js' -o -name '*.ts' -o -name '*.tsx')",
    "start": "cross-env TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --optimizeAssets --babelLoader --noLogicalScss",
    "test": "jest --coverage=false",
    "test:ci": "jest --runInBand --ci --logHeapUsage",
    "test:watch": "jest --watch --coverage=false"
  },
  "dependencies": {
    "@ariakit/react": "0.4.29",
    "@lexical/utils": "0.30.0",
    "@lexical/yjs": "0.30.0",
    "@proton/account": "workspace:^",
    "@proton/app-context": "workspace:^",
    "@proton/atoms": "workspace:^",
    "@proton/components": "workspace:^",
    "@proton/cross-storage": "workspace:^",
    "@proton/docs-core": "workspace:^",
    "@proton/docs-proto": "workspace:^",
    "@proton/docs-shared": "workspace:^",
    "@proton/drive": "workspace:^",
    "@proton/drive-store": "workspace:^",
    "@proton/features": "workspace:^",
    "@proton/hooks": "workspace:^",
    "@proton/icons": "workspace:^",
    "@proton/mail": "workspace:^",
    "@proton/metrics": "workspace:^",
    "@proton/pack": "workspace:^",
    "@proton/payments": "workspace:^",
    "@proton/polyfill": "workspace:^",
    "@proton/react-redux-store": "workspace:^",
    "@proton/redux-shared-store": "workspace:^",
    "@proton/redux-shared-store-types": "workspace:^",
    "@proton/redux-utilities": "workspace:^",
    "@proton/shared": "workspace:^",
    "@proton/styles": "workspace:^",
    "@proton/unleash": "workspace:^",
    "@proton/utils": "workspace:^",
    "@reduxjs/toolkit": "^2.12.0",
    "buffer": "^6.0.3",
    "history": "^4.10.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "react-router-dom-v5-compat": "^6.30.6",
    "ttag": "^1.8.12",
    "yjs": "^13.6.15",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@prettier/plugin-xml": "^3.4.2",
    "@proton/eslint-config-proton": "workspace:^",
    "@proton/i18n": "workspace:^",
    "@proton/jest-env": "workspace:^",
    "@proton/testing": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^30.4.1",
    "babel-plugin-transform-require-context": "^0.1.1",
    "core-js": "^3.50.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "jest-junit": "^16.0.0",
    "jest-when": "3.7.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.80.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2"
  }
}
