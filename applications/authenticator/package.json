{
    "name": "proton-authenticator",
    "scripts": {
        "build:desktop": "cross-env NODE_ENV=production API_ENV=proton.me tools/build.sh",
        "build:web": "cross-env NODE_ENV=production API_ENV=proton.me webpack --config webpack.config.ts",
        "check:types": "tsc --checkers 1",
        "fmt:native": "cd src-tauri && make fmt",
        "generate:api-types": "pnpm --silent --filter @proton/pass run generator:openapi \"https://$API/api/internal/doc?page=authenticator\" > ./src/lib/api/types.ts",
        "i18n:extract:desktop": "proton-i18n extract",
        "i18n:getlatest": "proton-i18n upgrade",
        "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin -u --verbose",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:desktop": "proton-i18n validate",
        "lint": "oxlint --quiet",
        "lint:native": "cd src-tauri && make lint",
        "make": "tauri bundle -v && bash tools/rename-after-make.sh",
        "start:desktop": "tauri dev --features devtools",
        "start:web": "cross-env API_ENV=proton.black webpack serve --config webpack.config.ts",
        "test": "jest",
        "test:ci": "jest --runInBand --ci --passWithNoTests --logHeapUsage"
    },
    "dependencies": {
        "@dnd-kit/collision": "catalog:",
        "@dnd-kit/dom": "catalog:",
        "@dnd-kit/helpers": "catalog:",
        "@dnd-kit/react": "catalog:",
        "@proton/app-context": "workspace:^",
        "@proton/atoms": "workspace:^",
        "@proton/colors": "workspace:^",
        "@proton/components": "workspace:^",
        "@proton/hooks": "workspace:^",
        "@proton/icons": "workspace:^",
        "@proton/pass": "workspace:^",
        "@proton/polyfill": "workspace:^",
        "@proton/shared": "workspace:^",
        "@proton/styles": "workspace:^",
        "@proton/types": "workspace:^",
        "@proton/utils": "workspace:^",
        "@protontech/authenticator-rust-core": "^0.28.8",
        "@protontech/crypto": "catalog:",
        "@reduxjs/toolkit": "catalog:",
        "@tanstack/react-virtual": "catalog:",
        "@tauri-apps/api": "^2.12.0",
        "@tauri-apps/plugin-dialog": "~2.8.0",
        "@tauri-apps/plugin-fs": "~2.6.0",
        "@tauri-apps/plugin-http": "~2.8.0",
        "@tauri-apps/plugin-log": "~2.10.0",
        "@tauri-apps/plugin-opener": "^2.7.0",
        "@tauri-apps/plugin-process": "~2.4.0",
        "@tauri-apps/plugin-updater": "~2.13.1",
        "@zxing/browser": "0.2.1",
        "@zxing/library": "0.23.0",
        "browserslist": "catalog:",
        "dexie": "^4.4.6",
        "dexie-react-hooks": "^1.1.7",
        "formik": "catalog:",
        "jsqr": "^1.4.0",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-redux": "catalog:",
        "redux": "catalog:",
        "ttag": "catalog:"
    },
    "devDependencies": {
        "@iarna/toml": "^2.2.5",
        "@pmmmwh/react-refresh-webpack-plugin": "catalog:",
        "@proton/i18n": "workspace:^",
        "@proton/jest-env": "workspace:^",
        "@proton/jest-swc-preset": "workspace:^",
        "@proton/oxlint-config": "workspace:^",
        "@proton/pack": "workspace:^",
        "@proton/unleash": "workspace:^",
        "@tauri-apps/cli": "^2.12.0",
        "@testing-library/jest-dom": "catalog:",
