{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["@proton/types", "global-types-monorepo", "webpack-env", "node", "vitest/globals"]
    },
    "ts-node": {
        "compilerOptions": {
            "rootDir": "../..",
            "module": "commonjs",
            "target": "esnext",
            "esModuleInterop": true
        },
        "ignore": ["node_modules/(?!@proton)"]
    }
}
