{
    "name": "proton-lumo",
    "version": "0.1.0",
    "description": "Proton Lumo web application",
    "license": "GPL-3.0",
    "main": "index.html",
    "scripts": {
        "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=sso --prependAsyncCss",
        "check-types": "tsc",
        "i18n:extract:web": "proton-i18n extract",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:web": "proton-i18n validate",
        "lint": "eslint --quiet",
        "pretty": "prettier --write  $(find src/app -type f -name '*.js' -o -name '*.ts' -o -name '*.tsx')",
        "start": "cross-env TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --no-error-logs --prependAsyncCss",
        "test": "jest --silent",
        "test:ci": "jest --coverage --runInBand --ci --silent",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@bjorn3/browser_wasi_shim": "^0.4.2",
        "@msgpack/msgpack": "^3.1.3",
        "@proton/atoms": "workspace:^",
        "@proton/drive": "workspace:^",
        "@proton/proton-foundation-search": "^1.1.2",
        "@proton/shared": "workspace:^",
        "@proton/styles": "workspace:^",
        "@protontech/crypto": "*",
        "@reduxjs/toolkit": "^2.12.0",
        "@tanstack/react-virtual": "^3.14.9",
        "@types/jest": "^30.0.0",
        "@types/tinycolor2": "^1.4.6",
        "@types/toposort": "^2.0.7",
        "@xyflow/react": "^12.11.3",
        "clsx": "^2.1.1",
        "d3-array": "^3.2.4",
        "d3-scale": "^4.0.2",
        "dompurify": "^3.4.13",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "json-stable-stringify": "^1.3.0",
        "jszip": "^3.10.1",
        "lodash": "^4.18.1",
        "lottie-react": "^2.4.2",
        "lucide-react": "^1.32.0",
        "p-limit": "^6.2.0",
        "pdfjs-dist": "5.4.530",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^9.1.0",
        "react-redux": "^9.3.0",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4",
        "react-syntax-highlighter": "^15.6.6",
        "react-textarea-autosize": "^8.5.9",
        "react-virtuoso": "^4.18.12",
        "recharts": "^3.10.1",
        "redux-saga": "^1.5.0",
        "rehype-katex": "^7.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "tinycolor2": "^1.6.0",
        "toposort": "^2.0.2",
        "ts-jest": "^29.4.12",
        "ttag": "^1.8.12",
        "turndown": "^7.2.4",
        "uuid": "^14.0.1",
        "vega": "^5.33.1",
        "vega-embed": "^7.1.0",
        "vega-interpreter": "^1.2.1",
        "vega-lite": "^5.23.0",
        "xlsx": "0.18.5"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@peculiar/webcrypto": "^1.7.1",
        "@proton/i18n": "workspace:^",
        "@proton/pack": "workspace:^",
        "@proton/testing": "workspace:^",
        "@types/node": "^24.13.3",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react-swc": "^3.11.0",
        "autoprefixer": "^10.5.4",
        "babel-plugin-transform-import-meta": "^2.3.3",
        "core-js": "^3.50.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "fake-indexeddb": "^6.2.5",
        "msw": "2.12.14",
        "postcss": "^8.5.26",
        "sass": "^1.80.3",
        "typescript": "^6.0.3",
        "vite": "^8.2.1"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
