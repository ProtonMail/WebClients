{
    "name": "proton-meet-desktop",
    "version": "1.0.14",
    "description": "Proton's official desktop application for Proton Meet",
    "license": "GPL-3.0",
    "author": {
        "name": "Proton",
        "email": "contact@proton.me",
        "url": "https://proton.me"
    },
    "type": "commonjs",
    "main": ".webpack/main",
    "scripts": {
        "check": "pnpm run check:format && pnpm run check:lint && pnpm run check:types",
        "check:format": "prettier . --check",
        "check:lint": "eslint --quiet",
        "check:types": "tsc --noEmit --checkers 1",
        "format": "prettier . --write --list-different",
        "i18n:extract:web": "node tasks/extract-translations.mjs",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:web": "proton-i18n validate",
        "lint": "pnpm run check:lint",
        "make": "electron-forge make",
        "make:beta": "cross-env RELEASE=beta electron-forge make",
        "package": "electron-forge package",
        "start": "electron-forge start",
        "test": "jest --runInBand"
    },
    "config": {
        "appBundleId": "ch.protonmeet.desktop",
        "appUserModelId": "com.squirrel.proton_meet.ProtonMeet",
        "copyright": "Copyright (c) 2026, Proton AG <contact@proton.me>",
        "githubRepo": "meet-desktop",
        "githubUser": "ProtonMeet",
        "updateInterval": 3600000
    },
    "dependencies": {
        "@proton/shared": "workspace:^",
        "electron-log": "catalog:",
        "electron-store": "catalog:",
        "execa": "^8.0.1",
        "lodash": "catalog:",
        "ttag": "catalog:",
        "ttag-cli": "catalog:",
        "update-electron-app": "^3.3.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@electron-forge/cli": "catalog:",
        "@electron-forge/maker-deb": "catalog:",
        "@electron-forge/maker-dmg": "catalog:",
        "@electron-forge/maker-rpm": "catalog:",
        "@electron-forge/maker-squirrel": "catalog:",
        "@electron-forge/maker-zip": "catalog:",
        "@electron-forge/plugin-auto-unpack-natives": "catalog:",
        "@electron-forge/plugin-fuses": "catalog:",
        "@electron-forge/plugin-webpack": "catalog:",
        "@electron-forge/publisher-github": "catalog:",
        "@electron-forge/shared-types": "catalog:",
        "@electron/fuses": "catalog:",
        "@eslint/js": "^9.39.5",
        "@proton/i18n": "workspace:^",
        "@proton/jest-swc-preset": "workspace:^",
        "@proton/types": "workspace:^",
        "@sentry/electron": "^7.20.0",
        "@types/jest": "catalog:",
        "@types/lodash": "catalog:",
        "@types/node": "catalog:",
        "@types/webpack-env": "catalog:",
        "@typescript/native": "catalog:",
        "@vercel/webpack-asset-relocator-loader": "catalog:",
        "cross-env": "catalog:",
        "css-loader": "catalog:",
        "dotenv": "^17.4.2",
        "electron": "43.7.6",
        "eslint": "catalog:",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "fork-ts-checker-webpack-plugin": "catalog:",
        "globals": "^14.0.0",
        "jest": "catalog:",
        "node-loader": "^2.1.0",
        "prettier": "3.9.10",
        "style-loader": "^4.0.0",
        "ts-loader": "catalog:",
        "ts-node": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "webpack": "catalog:"
    },
    "icon": "assets/icons/icon.png",
    "productName": "Proton Meet"
}
