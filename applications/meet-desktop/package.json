{
    "name": "proton-meet-desktop",
    "version": "1.0.10",
    "description": "Proton's official desktop application for Proton Meet",
    "license": "GPL-3.0",
    "author": {
        "name": "Proton",
        "email": "contact@protonmail.com",
        "url": "https://proton.me"
    },
    "type": "commonjs",
    "main": ".webpack/main",
    "scripts": {
        "check": "yarn run check:format && yarn run check:lint && yarn run check:types",
        "check:format": "prettier . --check",
        "check:lint": "eslint --quiet",
        "check:types": "tsc --noEmit",
        "check-types": "yarn run check:types",
        "format": "prettier . --write --list-different",
        "i18n:extract:web": "node tasks/extract-translations.mjs",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:web": "proton-i18n validate",
        "lint": "yarn run check:lint",
        "make": "electron-forge make",
        "make:beta": "cross-env RELEASE=beta electron-forge make",
        "package": "electron-forge package",
        "start": "electron-forge start",
        "test": "jest --runInBand"
    },
    "config": {
        "appBundleId": "ch.protonmeet.desktop",
        "appUserModelId": "com.squirrel.proton_meet.ProtonMeet",
        "copyright": "Copyright (c) 2026, Proton AG <contact@protonmail.com>",
        "githubRepo": "meet-desktop",
        "githubUser": "ProtonMail",
        "updateInterval": 3600000
    },
    "dependencies": {
        "@proton/shared": "workspace:^",
        "@types/minimist": "^1.2.5",
        "electron-log": "^5.4.4",
        "electron-squirrel-startup": "^1.0.1",
        "electron-store": "^8.2.0",
        "execa": "^8.0.1",
        "lodash": "^4.18.1",
        "minimist": "^1.2.8",
        "ttag": "^1.8.12",
        "ttag-cli": "^1.12.0",
        "update-electron-app": "^3.3.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.3.0",
        "@electron-forge/maker-deb": "^7.3.0",
        "@electron-forge/maker-dmg": "^7.3.0",
        "@electron-forge/maker-rpm": "^7.3.0",
        "@electron-forge/maker-squirrel": "^7.3.0",
        "@electron-forge/maker-zip": "^7.3.0",
        "@electron-forge/plugin-auto-unpack-natives": "^7.3.0",
        "@electron-forge/plugin-fuses": "^7.3.0",
        "@electron-forge/plugin-webpack": "^7.3.0",
        "@electron-forge/publisher-github": "^7.3.0",
        "@electron/fuses": "^1.7.0",
        "@proton/i18n": "workspace:^",
        "@proton/jest-swc-preset": "workspace:^",
        "@proton/types": "workspace:^",
        "@sentry/electron": "^7.17.0",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.25",
        "@types/node": "^24.13.3",
        "@vercel/webpack-asset-relocator-loader": "1.7.3",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.4",
        "dotenv": "^17.4.2",
        "electron": "39.8.10",
        "eslint": "^10.9.0",
        "eslint-plugin-import": "^2.32.0",
        "fork-ts-checker-webpack-plugin": "^9.1.0",
        "jest": "^30.4.2",
        "node-loader": "^2.1.0",
        "prettier": "3.9.6",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0"
    },
    "icon": "assets/icons/icon.png",
    "productName": "Proton Meet"
}
