{
    "name": "proton-pass-desktop",
    "version": "1.43.0",
    "description": "Proton Pass desktop application",
    "license": "GPL-3.0",
    "author": "Proton AG",
    "main": ".webpack/main",
    "scripts": {
        "build:desktop": "cross-env-shell NODE_ENV=production 'pnpm run build:native && electron-forge package'",
        "build:desktop:dev": "cross-env-shell NODE_ENV=production API_ENV=proton.black 'pnpm run build:native && electron-forge package'",
        "build:desktop:e2e": "cross-env-shell NODE_ENV=production E2E_TESTS=true 'pnpm run build:native && electron-forge package'",
        "build:mas": "cross-env-shell NODE_ENV=production SKIP_CODESIGN=1 SKIP_NOTARIZE=1 CSC_LINK=mas/app.p12 CSC_KEY_PASSWORD=$APP_CERT_PASSWORD CSC_INSTALLER_LINK=mas/installer.p12 CSC_INSTALLER_KEY_PASSWORD=$INSTALLER_CERT_PASSWORD 'pnpm run build:native && electron-forge package && cp -r .webpack/*/* .webpack/ && rm -rf .webpack/arm64 && electron-builder --config electron-builder.config.js'",
        "build:native": "cd native && pnpm run build",
        "check:types": "tsc --checkers 1",
        "clean:build:artifacts": "rm -rf dist && rm -rf out && rm -rf .webpack",
        "format:native": "cd native && make fmt",
        "i18n:extract:desktop": "proton-i18n extract",
        "i18n:getlatest": "proton-i18n upgrade",
        "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin -u --verbose",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:desktop": "proton-i18n validate",
        "lint": "eslint --quiet",
        "lint:native": "cd native && make lint",
        "make": "electron-forge make --skip-package",
        "pretty": "prettier --write 'src/**/*.{js,ts,tsx}'",
        "start": "cross-env-shell NODE_ENV=development API_ENV=proton.black 'electron-forge start'",
        "start:prod": "cross-env-shell NODE_ENV=development 'electron-forge start'",
        "test": "jest",
        "test:ci": "jest --runInBand --ci --passWithNoTests --logHeapUsage",
        "test:watch": "jest --watch",
        "update:serve": "node update/serve.mjs"
    },
    "dependencies": {
        "@proton/atoms": "workspace:^",
        "@proton/components": "workspace:^",
        "@proton/pass": "workspace:^",
        "@proton/shared": "workspace:^",
        "@proton/styles": "workspace:^",
        "@proton/utils": "workspace:^",
        "@protontech/crypto": "catalog:",
        "browserslist": "catalog:",
        "electron-log": "catalog:",
        "electron-store": "catalog:",
        "history": "catalog:",
        "lodash": "catalog:",
        "proton-pass-web": "workspace:proton-pass@^",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-router-dom": "catalog:",
        "ttag": "catalog:"
    },
    "devDependencies": {
        "@electron-forge/cli": "catalog:",
        "@electron-forge/maker-deb": "catalog:",
        "@electron-forge/maker-dmg": "catalog:",
        "@electron-forge/maker-msix": "catalog:",
        "@electron-forge/maker-rpm": "catalog:",
        "@electron-forge/maker-zip": "catalog:",
        "@electron-forge/plugin-auto-unpack-natives": "catalog:",
        "@electron-forge/plugin-fuses": "catalog:",
        "@electron-forge/plugin-webpack": "catalog:",
        "@electron-forge/shared-types": "catalog:",
        "@electron/fuses": "catalog:",
        "@pmmmwh/react-refresh-webpack-plugin": "catalog:",
        "@proton/eslint-config-proton": "workspace:^",
        "@proton/i18n": "workspace:^",
        "@proton/jest-env": "workspace:^",
        "@proton/jest-swc-preset": "workspace:^",
        "@proton/pack": "workspace:^",
        "@proton/prettier-config-proton": "workspace:^",
        "@proton/types": "workspace:^",
        "@testing-library/jest-dom": "catalog:",
        "@types/chrome": "catalog:",
        "@types/fs-extra": "^11.0.4",
        "@types/history": "catalog:",
        "@types/jest": "catalog:",
        "@types/lodash": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/react-router-dom": "catalog:",
        "@types/webpack-env": "catalog:",
        "@typescript/native": "catalog:",
        "@vercel/webpack-asset-relocator-loader": "catalog:",
        "cross-env": "catalog:",
        "electron": "44.5.0",
        "electron-builder": "26.15.3",
        "eslint": "catalog:",
        "fs-extra": "^11.4.1",
        "jest": "catalog:",
        "mini-css-extract-plugin": "catalog:",
        "node-loader": "^2.1.0",
        "prettier": "catalog:",
        "ts-loader": "catalog:",
        "ts-node": "catalog:",
        "typescript": "catalog:",
        "webpack": "catalog:"
    },
    "productName": "Proton Pass"
}
