{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["WebWorker", "DOM", "DOM.Iterable", "ESNext", "DOM.AsyncIterable"],
        "types": [
            "@proton/types",
            "global-types-monorepo",
            "webpack-env",
            "vitest/globals",
            "chrome",
            "./globals.d.ts"
        ],
        "paths": {
            "proton-pass-web/*": ["../pass/src/*"],
            "proton-pass-desktop-native": ["./native/"],
            "proton-pass-desktop-native/*": ["./native/*"]
        }
    },
    "ts-node": {
        "compilerOptions": {
            "rootDir": "../..",
            "module": "commonjs",
            "target": "esnext",
            "esModuleInterop": true
        },
        "ignore": ["node_modules/(?!@proton)"]
    }
}
