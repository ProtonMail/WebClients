{
    "name": "docs-homepage-standalone",
    "version": "0.0.0",
    "private": true,
    "description": "Local-only standalone host that opens the Docs homepage module (applications/docs/src/app/homepage) with empty mocks. Developers only: never built, deployed or shipped.",
    "type": "module",
    "scripts": {
        "check:types": "tsc --checkers 1",
        "format:check": "oxfmt --check \"**/*.{js,ts,tsx}\"",
        "format:write": "oxfmt --write \"**/*.{js,ts,tsx}\"",
        "lint": "oxlint --quiet",
        "start": "vite"
    },
    "dependencies": {
        "@proton/styles": "workspace:^",
        "proton-docs": "workspace:^",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@proton/oxlint-config": "workspace:^",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@typescript/native": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "sass": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:"
    }
}
