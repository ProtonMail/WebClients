{
    "name": "proton-pass-extension",
    "description": "Password Manager Browser Extension",
    "license": "GPL-3.0",
    "scripts": {
        "build:extension": "cross-env API_ENV=proton.me BUILD_TARGET=${BUILD_TARGET:-chrome} sh -c 'pnpm run clean && pnpm run build:extension:helper'",
        "build:extension:all": "./tools/build-all.sh",
        "build:extension:beta": "./tools/build-all.sh --beta",
        "build:extension:dev": "cross-env API_ENV=proton.black BUILD_TARGET=${BUILD_TARGET:-chrome} sh -c 'pnpm run clean && pnpm run build:extension:helper'",
        "build:extension:e2e": "cross-env BUILD_TARGET=chrome E2E_TESTS=true NODE_ENV=production webpack --config webpack.config.ts",
        "build:extension:env": "cross-env BUILD_TARGET=${BUILD_TARGET:-chrome} sh -c 'pnpm run clean && pnpm run build:extension:helper'",
        "build:extension:ff": "cross-env RELEASE=true NODE_ENV=production BUILD_TARGET=firefox API_ENV=proton.me sh -c 'pnpm run build:extension:helper'",
        "build:extension:helper": "NODE_ENV=production webpack --config webpack.config.ts && ./tools/release.sh ./dist",
        "check:types": "tsc --checkers 1",
        "check:types:watch": "tsc --watch",
        "clean": "rm -rf ./dist/",
        "config:clean": "rm -f config.lock.json",
        "config:lock": "ts-node -e \"import('./webpack.options').then(({ webpackOptions }) => console.log(JSON.stringify(webpackOptions.defineWebpackConfig, null, 4)))\" > ./config.lock.json",
        "debugger:http": "node -e \"require('./tools/debugger-server.js')()\"",
        "i18n:extract:extension": "proton-i18n extract",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:extension": "proton-i18n validate",
        "lint": "eslint --quiet",
        "pretty": "prettier --write  $(find src/app -type f -name '*.js' -o -name '*.ts' -o -name '*.tsx')",
        "start": "pnpm run clean && RESUME_FALLBACK=true API_ENV=${API_ENV:-proton.black} ts-node ./tools/dev-server.ts",
        "start:prod": "pnpm run clean && API_ENV=proton.me ts-node ./tools/dev-server.ts",
        "start:prod:reload": "pnpm run clean && API_ENV=proton.me RUNTIME_RELOAD=true ts-node ./tools/dev-server.ts",
        "start:reload": "cross-env RUNTIME_RELOAD=true sh -c 'pnpm run start'",
        "test": "jest --coverage",
        "test:ci": "jest --runInBand --ci --logHeapUsage",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@proton/app-context": "workspace:^",
        "@proton/atoms": "workspace:^",
        "@proton/components": "workspace:^",
        "@proton/hooks": "workspace:^",
        "@proton/icons": "workspace:^",
        "@proton/pass": "workspace:^",
        "@proton/shared": "workspace:^",
        "@proton/styles": "workspace:^",
        "@proton/utils": "workspace:^",
        "@protontech/autofill": "0.0.38040317",
        "@protontech/fathom": "0.0.38040317",
        "@redux-devtools/remote": "^0.9.5",
        "@reduxjs/toolkit": "catalog:",
        "@sentry/browser": "catalog:",
        "argon2id": "^1.0.1",
        "formik": "catalog:",
        "lodash": "catalog:",
        "react-dom": "catalog:",
        "react-helmet": "^6.1.0",
        "react-redux": "catalog:",
        "react-router-dom": "catalog:",
        "redux-saga": "catalog:",
        "ts-node": "catalog:",
        "ttag": "catalog:",
        "webextension-polyfill": "^0.12.0"
    },
    "devDependencies": {
        "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
        "@proton/eslint-config-proton": "workspace:^",
        "@proton/i18n": "workspace:^",
        "@proton/jest-env": "workspace:^",
        "@proton/jest-swc-preset": "workspace:^",
        "@proton/pack": "workspace:^",
        "@proton/types": "workspace:^",
        "@protontech/pass-rust-core": "1.6.0",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "^15.0.7",
        "@types/chrome": "catalog:",
        "@types/jest": "catalog:",
        "@types/lodash": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/react-helmet": "^6.1.11",
        "@types/react-router-dom": "catalog:",
        "@types/socketcluster-server": "^19.0.1",
        "@types/webextension-polyfill": "^0.12.6",
        "@types/webpack-env": "catalog:",
        "@typescript/native": "catalog:",
        "circular-dependency-plugin": "^5.2.2",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "catalog:",
        "eslint": "catalog:",
        "jest": "catalog:",
        "mini-css-extract-plugin": "^2.10.2",
        "prettier": "catalog:",
        "react": "catalog:",
        "redux": "catalog:",
        "socketcluster-server": "^19.2.2",
        "string-replace-loader": "^3.3.0",
        "typescript": "catalog:",
        "webpack": "^5.111.1",
        "webpack-bundle-analyzer": "^5.4.0",
        "webpack-dev-server": "^6.0.0"
    },
    "peerDependencies": {
        "react": "^18.3.1",
        "redux": "^5.0.1"
    }
}
