{
    "name": "proton-pass",
    "description": "Proton Pass web application",
    "license": "GPL-3.0",
    "author": "",
    "scripts": {
        "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=sso --noLogicalScss",
        "check:types": "tsc --checkers 1",
        "i18n:extract:web": "proton-i18n extract",
        "i18n:getlatest": "proton-i18n upgrade",
        "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin -u --verbose",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:web": "proton-i18n validate",
        "lint": "oxlint --quiet",
        "pretty": "prettier --write  $(find src/app -type f -name '*.js' -o -name '*.ts' -o -name '*.tsx')",
        "start": "cross-env TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --no-error-logs --noLogicalScss",
        "test": "jest",
        "test:ci": "jest --runInBand --ci --logHeapUsage",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@proton/app-context": "workspace:^",
        "@proton/atoms": "workspace:^",
        "@proton/components": "workspace:^",
        "@proton/hooks": "workspace:^",
        "@proton/icons": "workspace:^",
        "@proton/pass": "workspace:^",
        "@proton/polyfill": "workspace:^",
        "@proton/shared": "workspace:^",
        "@proton/styles": "workspace:^",
        "@proton/utils": "workspace:^",
        "@reduxjs/toolkit": "catalog:",
        "history": "catalog:",
        "idb": "catalog:",
        "lodash": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-redux": "catalog:",
        "react-router-dom": "catalog:",
        "redux": "catalog:",
        "redux-saga": "catalog:",
        "ttag": "catalog:"
    },
    "devDependencies": {
        "@proton/i18n": "workspace:^",
        "@proton/jest-env": "workspace:^",
        "@proton/jest-swc-preset": "workspace:^",
        "@proton/oxlint-config": "workspace:^",
        "@proton/pack": "workspace:^",
        "@proton/types": "workspace:^",
        "@proton/unleash": "workspace:^",
        "@protontech/crypto": "catalog:",
        "@testing-library/jest-dom": "catalog:",
        "@types/chrome": "catalog:",
        "@types/history": "catalog:",
        "@types/jest": "catalog:",
        "@types/lodash": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/react-router-dom": "catalog:",
        "@types/webpack-env": "catalog:",
        "@typescript/native": "catalog:",
        "cross-env": "catalog:",
        "jest": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "prettier": "catalog:",
        "typescript": "catalog:",
        "webpack": "catalog:",
        "webpack-manifest-plugin": "^6.0.1"
    }
}
