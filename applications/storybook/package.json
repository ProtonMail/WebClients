{
    "name": "proton-storybook",
    "description": "",
    "keywords": [],
    "license": "GPL-3.0",
    "scripts": {
        "build": "pnpm run build:clean && storybook build --loglevel warn --quiet",
        "build:clean": "rimraf ./storybook-static",
        "build:serve": "http-server ./storybook-static --cors --port 3000 --silent",
        "build:wait": "wait-on http://localhost:3000",
        "check:types": "tsc --checkers 1",
        "deploy": "netlify deploy --auth $NETLIFY_AUTH_TOKEN --site $NETLIFY_SITE_ID --dir applications/storybook/storybook-static --alias $NETLIFY_ALIAS",
        "deploy:prod": "netlify deploy --auth $NETLIFY_AUTH_TOKEN --site $NETLIFY_SITE_ID --prod --dir applications/storybook/storybook-static",
        "dev": "storybook dev -p 6006",
        "docs": "pnpm run dev --docs",
        "lint": "eslint --quiet",
        "pretty": "prettier --write $(find . -path ./node_modules -prune -o -path ./src -type f -name '*.js' -o -name '*.ts' -o -name '*.tsx')",
        "test:visual": "pnpm run build:wait && playwright test --config=playwright.config.ts",
        "test:visual:clean": "rimraf ./tests/stories-visual.test.ts-snapshots",
        "test:visual:update": "pnpm run test:visual:clean && pnpm run test:visual -u"
    },
    "dependencies": {
        "@proton/app-context": "workspace:^",
        "@proton/atoms": "workspace:^",
        "@proton/charts": "workspace:^",
        "@proton/colors": "workspace:^",
        "@proton/components": "workspace:^",
        "@proton/eslint-config-proton": "workspace:^",
        "@proton/hooks": "workspace:^",
        "@proton/icons": "workspace:^",
        "@proton/pack": "workspace:^",
        "@proton/shared": "workspace:^",
        "@proton/styles": "workspace:^",
        "@proton/utils": "workspace:^",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@types/react-router-dom": "^5.3.3",
        "eslint": "^10.11.0",
        "prettier": "^3.9.9",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^5.3.4",
        "ttag": "^1.8.12",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "webpack": "^5.111.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@storybook/addon-docs": "^10.6.1",
        "@storybook/addon-links": "^10.6.1",
        "@storybook/react-webpack5": "^10.6.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint-plugin-storybook": "^10.6.1",
        "http-server": "^14.1.1",
        "netlify-cli": "27.10.2",
        "rimraf": "^6.1.3",
        "storybook": "^10.6.1",
        "terser-webpack-plugin": "^5.6.1",
        "wait-on": "^9.5.1"
    }
}
