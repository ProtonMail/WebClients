{
    "name": "proton-vpn-settings",
    "description": "ProtonVPN React web application",
    "keywords": [],
    "license": "GPL-3.0",
    "author": "",
    "scripts": {
        "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=standalone",
        "check:types": "tsc --checkers 1",
        "i18n:extract:web": "proton-i18n extract",
        "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin --verbose",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:web": "proton-i18n validate",
        "lint": "eslint --quiet",
        "pretty": "prettier --write  $(find src/app -type f -name '*.js' -o -name '*.ts' -o -name '*.tsx')",
        "start": "cross-env TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server",
        "test": "vitest run",
        "test:ci": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@proton/account": "workspace:^",
        "@proton/activation": "workspace:^",
        "@proton/atoms": "workspace:^",
        "@proton/calendar": "workspace:^",
        "@proton/calendar-video-conferencing": "workspace:^",
        "@proton/colors": "workspace:^",
        "@proton/components": "workspace:^",
        "@proton/hooks": "workspace:^",
        "@proton/icons": "workspace:^",
        "@proton/nav": "workspace:^",
        "@proton/pack": "workspace:^",
        "@proton/payments": "workspace:^",
        "@proton/payments-ui": "workspace:^",
        "@proton/polyfill": "workspace:^",
        "@proton/redux-shared-store": "workspace:^",
        "@proton/redux-shared-store-types": "workspace:^",
        "@proton/shared": "workspace:^",
        "@proton/styles": "workspace:^",
        "@proton/unleash": "workspace:^",
        "@proton/utils": "workspace:^",
        "@proton/vpn": "workspace:^",
        "@reduxjs/toolkit": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/react-router-dom": "catalog:",
        "history": "catalog:",
        "lodash": "catalog:",
        "proton-account": "workspace:^",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-redux": "catalog:",
        "react-router": "catalog:",
        "react-router-dom": "catalog:",
        "redux": "catalog:",
        "ttag": "catalog:"
    },
    "devDependencies": {
        "@proton/eslint-config-proton": "workspace:^",
        "@proton/i18n": "workspace:^",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "^15.0.7",
        "@types/history": "catalog:",
        "@types/lodash": "catalog:",
        "@types/react-router": "catalog:",
        "@types/webpack-env": "catalog:",
        "@typescript/native": "catalog:",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "cross-env": "catalog:",
        "eslint": "catalog:",
        "html-webpack-plugin": "^5.6.8",
        "jsdom": "^26.1.0",
        "prettier": "catalog:",
        "typescript": "catalog:",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "webpack": "^5.111.1",
        "webpack-dev-server": "^6.0.0"
    }
}
