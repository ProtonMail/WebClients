{
    "name": "proton-meet",
    "description": "Proton-meet",
    "license": "GPL-3.0",
    "author": "",
    "scripts": {
        "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=sso",
        "check-types": "tsc",
        "i18n:extract:web": "proton-i18n extract",
        "i18n:getlatest": "proton-i18n upgrade",
        "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin -u --verbose",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:web": "proton-i18n validate",
        "lint": "eslint --quiet",
        "pretty": "prettier --write  $(find src/app -type f -name '*.js' -o -name '*.ts' -o -name '*.tsx')",
        "start": "cross-env TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone",
        "test": "TZ=UTC vitest",
        "test:ci": "TZ=UTC vitest run --coverage --coverage.provider=v8",
        "test:ui": "yarn test --ui",
        "test:watch": "yarn test --watch"
    },
    "dependencies": {
        "@dnd-kit/dom": "^0.5.0",
        "@dnd-kit/react": "^0.5.0",
        "@emoji-mart/data": "^1.0.3",
        "@livekit/components-core": "0.12.15",
        "@livekit/components-react": "^2.9.24",
        "@livekit/krisp-noise-filter": "^0.4.4",
        "@livekit/track-processors": "^0.7.2",
        "@mediapipe/tasks-vision": "^0.10.14",
        "@proton-meet/proton-meet-core": "1.3.6",
        "@proton/account": "workspace:^",
        "@proton/app-context": "workspace:packages/app-context",
        "@proton/atoms": "workspace:packages/atoms",
        "@proton/components": "workspace:packages/components",
        "@proton/cross-storage": "workspace:packages/cross-storage",
        "@proton/features": "workspace:^",
        "@proton/hooks": "workspace:^",
        "@proton/icons": "workspace:^",
        "@proton/meet": "workspace:packages/meet",
        "@proton/pack": "workspace:packages/pack",
        "@proton/payments": "workspace:^",
        "@proton/polyfill": "workspace:packages/polyfill",
        "@proton/react-redux-store": "workspace:^",
        "@proton/redux-shared-store": "workspace:^",
        "@proton/redux-shared-store-types": "workspace:^",
        "@proton/redux-utilities": "workspace:^",
        "@proton/sanitize": "workspace:packages/sanitize",
        "@proton/shared": "workspace:packages/shared",
        "@proton/styles": "workspace:packages/styles",
        "@proton/unleash": "workspace:^",
        "@proton/utils": "workspace:^",
        "@protontech/crypto": "*",
        "@reduxjs/toolkit": "^2.12.0",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@types/react-router-dom": "^5.3.3",
        "@types/wicg-file-system-access": "2023.10.7",
        "@workadventure/noise-suppression": "0.1.1",
        "clsx": "^2.1.1",
        "cross-env": "^10.1.0",
        "date-fns": "^2.30.0",
        "date-fns-tz": "^2.0.1",
        "emoji-mart": "^5.1.0",
        "history": "^4.10.1",
        "livekit-client": "2.22.0",
        "lodash": "^4.18.1",
        "mediabunny": "^1.55.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-redux": "^9.3.0",
        "react-router-dom": "^5.3.4",
        "ttag": "^1.8.12",
        "webpack": "^5.109.2"
    },
    "devDependencies": {
        "@proton/eslint-config-proton": "workspace:packages/eslint-config-proton",
        "@proton/i18n": "workspace:packages/i18n",
        "@proton/testing": "workspace:packages/testing",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^15.0.7",
        "@testing-library/user-event": "^14.6.6",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/coverage-v8": "^4.1.11",
        "@vitest/ui": "3.2.7",
        "dotenv": "^17.4.2",
        "eslint": "^10.9.0",
        "happy-dom": "^20.11.6",
        "html-webpack-plugin": "^5.6.8",
        "path-browserify": "^1.0.1",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vite-plugin-wasm": "^3.6.0",
        "vitest": "^4.1.11"
    }
}
