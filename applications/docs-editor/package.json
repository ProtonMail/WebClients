{
  "name": "proton-docs-editor",
  "description": "Editor for Proton Docs.",
  "scripts": {
    "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=sso --babelLoader --noLogicalScss",
    "check:types": "tsc --checkers 1",
    "docs:scan-imports": "node scripts/scan-document-imports.mjs",
    "i18n:extract:web": "proton-i18n extract",
    "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin --verbose",
    "i18n:validate": "proton-i18n validate lint-functions",
    "i18n:validate:context:web": "proton-i18n validate",
    "lint": "eslint --quiet",
    "lint:warning": "eslint",
    "sheets:export-functions": "node scripts/export-sheet-functions.mjs",
    "sheets:scan-imports": "node scripts/scan-spreadsheet-imports.mjs",
    "standalone-doc": "cross-env STANDALONE_DOC=true TS_NODE_TRANSPILE_ONLY=true TS_NODE_IGNORE_DIAGNOSTICS=5011 TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --babelLoader --noLogicalScss --no-api-proxy --no-error-logs --port 8091",
    "standalone-sheet": "cross-env STANDALONE_SHEET=true TS_NODE_TRANSPILE_ONLY=true TS_NODE_IGNORE_DIAGNOSTICS=5011 TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --babelLoader --noLogicalScss --no-api-proxy --no-error-logs --port 8090",
    "start": "cross-env TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --babelLoader --noLogicalScss",
    "test": "jest",
    "test:ci": "jest --runInBand --ci --logHeapUsage",
    "test:watch": "jest --watch --coverage=false"
  },
  "dependencies": {
    "@ariakit/react": "0.4.29",
