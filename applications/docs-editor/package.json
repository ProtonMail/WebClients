{
  "name": "proton-docs-editor",
  "description": "Editor for Proton Docs.",
  "scripts": {
    "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=sso --babelLoader --noLogicalScss",
    "check:types": "tsc --checkers 1",
    "i18n:extract:web": "proton-i18n extract",
    "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin --verbose",
    "i18n:validate": "proton-i18n validate lint-functions",
    "i18n:validate:context:web": "proton-i18n validate",
    "lint": "oxlint --quiet",
    "lint:warning": "oxlint",
    "start": "cross-env TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --babelLoader --noLogicalScss",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lexical/clipboard": "catalog:docs",
    "@lexical/code": "catalog:docs",
    "@lexical/hashtag": "catalog:docs",
    "@lexical/headless": "catalog:docs",
    "@lexical/html": "catalog:docs",
    "@lexical/link": "catalog:docs",
    "@lexical/list": "catalog:docs",
    "@lexical/markdown": "catalog:docs",
    "@lexical/overflow": "catalog:docs",
    "@lexical/react": "catalog:docs",
    "@lexical/rich-text": "catalog:docs",
    "@lexical/selection": "catalog:docs",
    "@lexical/table": "catalog:docs",
    "@lexical/text": "catalog:docs",
    "@lexical/utils": "catalog:docs",
    "@lexical/yjs": "catalog:docs",
    "@proton-docs/docs-editor": "0.7.1",
    "@proton-docs/sheets-editor": "0.2.5",
    "@proton/account": "workspace:^",
    "@proton/app-context": "workspace:^",
    "@proton/atoms": "workspace:^",
    "@proton/components": "workspace:^",
    "@proton/docs-core": "workspace:^",
    "@proton/docs-shared": "workspace:^",
    "@proton/hooks": "workspace:^",
    "@proton/pack": "workspace:^",
    "@proton/polyfill": "workspace:^",
    "@proton/shared": "workspace:^",
    "@proton/styles": "workspace:^",
    "@proton/utils": "workspace:^",
    "@protontech/crypto": "catalog:",
    "lexical": "catalog:docs",
    "lodash": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "ttag": "catalog:",
    "yjs": "catalog:",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@proton/i18n": "workspace:^",
    "@proton/metrics": "workspace:^",
    "@proton/oxlint-config": "workspace:^",
    "@proton/unleash": "workspace:^",
    "@proton/vitest-config": "workspace:^",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webpack-env": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "dotenv": "^17.4.2",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sass": "catalog:",
    "tailwindcss": "^3.4.19",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webpack": "catalog:",
    "y-protocols": "catalog:"
  }
}
