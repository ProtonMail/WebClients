{
  "name": "proton-docs-editor",
  "description": "Editor for Proton Docs.",
  "scripts": {
    "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=sso --babelLoader --noLogicalScss",
    "check:types": "tsc --checkers 1",
    "i18n:extract:web": "proton-i18n extract",
    "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin --verbose",
    "i18n:validate": "proton-i18n validate lint-functions",
    "i18n:validate:context:web": "proton-i18n validate",
    "lint": "oxlint --quiet",
    "lint:warning": "oxlint",
    "standalone-doc": "cross-env STANDALONE_DOC=true TS_NODE_TRANSPILE_ONLY=true TS_NODE_IGNORE_DIAGNOSTICS=5011 TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --babelLoader --noLogicalScss --no-api-proxy --no-error-logs --port 8091",
    "standalone-sheet": "cross-env STANDALONE_SHEET=true TS_NODE_TRANSPILE_ONLY=true TS_NODE_IGNORE_DIAGNOSTICS=5011 TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --babelLoader --noLogicalScss --no-api-proxy --no-error-logs --port 8090",
    "start": "cross-env TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --babelLoader --noLogicalScss",
    "test": "jest",
    "test:ci": "jest --runInBand --ci --logHeapUsage",
    "test:watch": "jest --watch --coverage=false"
  },
  "dependencies": {
    "@lexical/clipboard": "catalog:",
    "@lexical/code": "catalog:",
    "@lexical/hashtag": "catalog:",
    "@lexical/headless": "catalog:",
    "@lexical/html": "catalog:",
    "@lexical/link": "catalog:",
    "@lexical/list": "catalog:",
    "@lexical/markdown": "catalog:",
    "@lexical/overflow": "catalog:",
    "@lexical/react": "catalog:",
    "@lexical/rich-text": "catalog:",
    "@lexical/selection": "catalog:",
    "@lexical/table": "catalog:",
    "@lexical/text": "catalog:",
    "@lexical/utils": "catalog:",
    "@lexical/yjs": "catalog:",
    "@proton-docs/docs-editor": "0.1.8",
    "@proton-docs/sheets-editor": "0.1.56",
    "@proton/account": "workspace:^",
    "@proton/app-context": "workspace:^",
    "@proton/atoms": "workspace:^",
    "@proton/components": "workspace:^",
    "@proton/docs-core": "workspace:^",
    "@proton/docs-shared": "workspace:^",
    "@proton/hooks": "workspace:^",
    "@proton/pack": "workspace:^",
    "@proton/polyfill": "workspace:^",
    "@proton/shared": "workspace:^",
    "@proton/styles": "workspace:^",
    "@proton/utils": "workspace:^",
    "@protontech/crypto": "catalog:",
    "lexical": "catalog:",
    "lodash": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "ttag": "catalog:",
    "yjs": "catalog:",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.29.7",
    "@proton/i18n": "workspace:^",
    "@proton/jest-env": "workspace:^",
    "@proton/jest-swc-preset": "workspace:^",
    "@proton/metrics": "workspace:^",
    "@proton/oxlint-config": "workspace:^",
    "@proton/unleash": "workspace:^",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "^15.0.7",
    "@types/jest": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webpack-env": "catalog:",
    "@typescript/native": "catalog:",
    "babel-jest": "catalog:",
    "babel-plugin-transform-require-context": "^0.1.1",
    "browserslist": "catalog:",
    "core-js": "catalog:",
    "cross-env": "catalog:",
    "dotenv": "^17.4.2",
    "jest": "catalog:",
    "jest-junit": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sass": "catalog:",
    "tailwindcss": "^3.4.19",
    "typescript": "catalog:",
    "webpack": "catalog:",
    "y-protocols": "catalog:"
  }
}
