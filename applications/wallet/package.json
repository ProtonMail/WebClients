{
    "name": "proton-wallet",
    "description": "Proton-wallet",
    "license": "GPL-3.0",
    "author": "",
    "scripts": {
        "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=sso --noLogicalScss",
        "check:types": "tsc --checkers 1",
        "i18n:extract:web": "proton-i18n extract",
        "i18n:getlatest": "proton-i18n upgrade",
        "i18n:upgrade": "proton-i18n extract --verbose && proton-i18n crowdin -u --verbose",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:web": "proton-i18n validate",
        "lint": "eslint --quiet --fix",
        "pretty": "prettier --write  $(find src/app -type f -name '*.js' -o -name '*.ts' -o -name '*.tsx')",
        "start": "cross-env TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --noLogicalScss",
        "test": "TZ=UTC vitest",
        "test:ci": "pnpm run test --run",
        "test:ui": "pnpm run test --ui",
        "test:watch": "pnpm run test --watch"
    },
    "dependencies": {
        "@proton/account": "workspace:^",
        "@proton/andromeda": "workspace:andromeda-wasm@^",
        "@proton/app-context": "workspace:^",
        "@proton/atoms": "workspace:^",
        "@proton/colors": "workspace:^",
        "@proton/components": "workspace:^",
        "@proton/cross-storage": "workspace:^",
        "@proton/features": "workspace:^",
        "@proton/hooks": "workspace:^",
        "@proton/icons": "workspace:^",
        "@proton/key-transparency": "workspace:^",
        "@proton/mail": "workspace:^",
        "@proton/pack": "workspace:^",
        "@proton/payments": "workspace:^",
        "@proton/polyfill": "workspace:^",
        "@proton/redux-shared-store": "workspace:^",
        "@proton/shared": "workspace:^",
        "@proton/styles": "workspace:^",
        "@proton/unleash": "workspace:^",
        "@proton/utils": "workspace:^",
        "@proton/wallet": "workspace:^",
        "@protontech/crypto": "*",
        "@ramp-network/ramp-instant-sdk": "^4.0.8",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@types/react-router-dom": "^5.3.3",
        "chart.js": "^4.5.1",
        "cross-env": "^10.1.0",
        "date-fns": "^2.30.0",
        "jsqr": "^1.4.0",
        "lodash": "^4.18.1",
        "path-browserify": "^1.0.1",
        "react": "^18.3.1",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^5.3.4",
        "ttag": "^1.8.12",
        "webpack": "^5.111.1"
    },
    "devDependencies": {
        "@proton/eslint-config-proton": "workspace:^",
        "@proton/i18n": "workspace:^",
        "@proton/pass": "workspace:^",
        "@proton/vitest-config": "workspace:^",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^15.0.7",
        "@testing-library/react-hooks": "^8.0.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.11.0",
        "happy-dom": "^20.14.5",
        "html-webpack-plugin": "^5.6.8",
        "prettier": "^3.9.9",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vite-plugin-wasm": "^3.6.0",
        "vitest": "^5.0.2"
    },
    "exifreader": {
        "exclude": {
            "xmp": true
        }
    }
}
