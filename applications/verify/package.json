{
    "name": "proton-verify",
    "description": "Human Verification",
    "license": "GPL-3.0",
    "scripts": {
        "build:web": "cross-env NODE_ENV=production TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack build --appMode=standalone --noLogicalScss",
        "check:types": "tsc --checkers 1",
        "format:check": "oxfmt --check \"**/*.{js,ts,tsx}\"",
        "format:write": "oxfmt --write \"**/*.{js,ts,tsx}\"",
        "i18n:extract:web": "proton-i18n extract",
        "i18n:validate": "proton-i18n validate lint-functions",
        "i18n:validate:context:web": "proton-i18n validate",
        "lint": "oxlint --quiet",
        "start": "cross-env TS_NODE_PROJECT=\"../../tsconfig.webpack.json\" proton-pack dev-server --appMode=standalone --noLogicalScss",
        "test": "vitest run",
        "test:ci": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@proton/account": "workspace:^",
        "@proton/app-context": "workspace:^",
        "@proton/components": "workspace:^",
        "@proton/hooks": "workspace:^",
        "@proton/polyfill": "workspace:^",
        "@proton/redux-shared-store": "workspace:^",
        "@proton/shared": "workspace:^",
        "@proton/styles": "workspace:^",
        "@reduxjs/toolkit": "catalog:",
        "@types/react": "catalog:react19",
        "@types/react-dom": "catalog:react19",
        "@types/react-router-dom": "catalog:",
        "react": "catalog:react19",
        "react-dom": "catalog:react19",
        "react-router": "catalog:",
        "react-router-dom": "catalog:",
        "ttag": "catalog:"
    },
    "devDependencies": {
        "@proton/i18n": "workspace:^",
        "@proton/oxlint-config": "workspace:^",
        "@proton/pack": "workspace:^",
        "@proton/vitest-config": "workspace:^",
        "@types/node": "catalog:",
        "@types/react-router": "catalog:",
        "@types/webpack-env": "catalog:",
        "@typescript/native": "catalog:",
        "@unleash/proxy-client-react": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "cross-env": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "webpack": "catalog:"
    }
}
