{
    "name": "root",
    "private": true,
    "license": "GPL-3.0",
    "scripts": {
        "app-versions": "bash utilities/app-versions/app-versions.sh",
        "check:branch": "node utilities/repo-rules/src/branch-check/run.ts",
        "check:constraints": "node utilities/repo-rules/src/workspace-constraints/run.ts",
        "config-app": "(packages/config/install 2>/dev/null) || true",
        "create-atom": "pnpm --filter @proton/atoms run create-atom",
        "drive:test-index:staged": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/drive/tools/tests-mapping/test-index.ts --staged",
        "preinstall": "node --experimental-strip-types utilities/repo-rules/src/enforce-pnpm/run.ts",
        "postinstall": "is-ci || (husky; pnpm run config-app)",
        "knip": "knip",
        "knip:staged": "node utilities/repo-rules/src/knip-staged/run.ts",
        "nyc": "npx nyc",
        "start-all": "cd utilities/local-sso && bash ./run.sh",
        "version": "pnpm --filter @proton/version run version"
    },
    "dependencies": {
        "@proton/stylelint-config-proton": "workspace:^",
        "is-ci": "^4.1.0",
        "stylelint-config-standard-scss": "^10.0.0",
        "stylelint-use-logical-spec": "^5.0.1",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@proton/oxfmt-config": "workspace:^",
        "@proton/types": "workspace:^",
        "@types/global-types-monorepo": "workspace:^",
        "@types/node": "catalog:",
        "@typescript/native": "catalog:",
        "husky": "^9.1.7",
        "knip": "^6.45.1",
        "lint-staged": "^17.6.1",
        "nyc": "^17.1.0",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "sort-package-json": "^4.1.0",
        "stylelint": "catalog:",
        "turbo": "2.11.12"
    },
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": "^26.13.1",
        "pnpm": "^12.21.0"
    },
    "publishConfig": {
        "registry": "https://pkg.protontech.ch/npm/web-npm/"
    }
}
